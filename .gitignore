# build output
build/
build-*/
*.o
*.obj
*.dll
*.so
*.exe
*.pdb
*.ilk
*.lib
*.exp

# proxy configuration and captures (they contain a VIN)
proxy/j2534proxy.ini
# Anchored: an unanchored "logs/" would also swallow python/volvo_diag/logs/,
